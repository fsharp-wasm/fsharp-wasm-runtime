{
  "name": "fsharp-wasm-runtime",
  "version": "0.1.0",
  "description": "Browser runtime for F# compiled to WebAssembly GC",
  "type": "module",
  "scripts": {
    "build": "node build/build.js",
    "serve": "npx serve site -l 8080",
    "test": "fable tests/Unit --lang wasmgc -o dist/test/ && node dist/test/run.js",
    "test:e2e": "node tests/e2e/demos.mjs && node tests/e2e/site.mjs",
    "clean": "rm -rf dist release",
    "site": "node build/build.js && node build/site.mjs"
  },
  "keywords": [
    "fsharp",
    "wasm",
    "wasmgc",
    "webassembly",
    "browser",
    "runtime"
  ],
  "author": "fsharp-wasm contributors",
  "license": "Apache-2.0",
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "serve": "^14.2.0"
  }
}
